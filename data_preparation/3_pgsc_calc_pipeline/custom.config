// Leave 20 GB of the Slurm allocation for Nextflow and other overhead.
executor {
    name = 'local'
    cpus = 16
    memory = 160.GB
}

process {
    executor = 'local'

    withName: 'FORMAT_SCOREFILES' {
        cpus = 4
        memory = 64.GB
        maxForks = 1
    }

    withName: 'PLINK2_SCORE' {
        cpus = 8
        memory = 64.GB
        maxForks = 1
        scratch = true
        stageInMode = 'copy'
    }

    withName: 'PLINK2_RELABELPVAR|FILTER_VARIANTS|INTERSECT_THINNED' {
        cpus = 1
        memory = 64.GB
    }

    withName: 'INTERSECT_VARIANTS' {
        cpus = 1
        memory = 96.GB
        maxForks = 1
    }

    withName: 'MATCH_VARIANTS' {
        cpus = 4
        memory = 128.GB
        maxForks = 1
    }

    withName: 'MATCH_COMBINE' {
        cpus = 4
        memory = 96.GB
        maxForks = 1
    }
}

params {
    max_cpus = 16
    max_memory = 160.GB
    max_time = 20.h
}
